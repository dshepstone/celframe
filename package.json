{
  "name": "celframe-workspace",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "node --test \"scripts/*.test.mjs\" && pnpm -r --if-present test",
    "licenses:check": "node scripts/check-js-licences.mjs",
    "cleanroom:check": "node scripts/check-clean-room.mjs"
  }
}
